# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring

# Admin kirishi (majburiy)
ADMIN_USER=admin
ADMIN_PASS=admin_password

# Sessiya kaliti (tavsiya): python -c "import secrets;print(secrets.token_hex(32))"
# Bo'sh qoldirsangiz, DATA_DIR ichida .secret_key fayli avtomatik yaratiladi
SECRET_KEY=127.0.0.1

# Sayt nomi va ta'rifi (logotip, sarlavha va footerda ko'rinadi)
SITE_NAME=Notes
SITE_TAGLINE=Fikrlar, kitoblar va kundalik kuzatuvlar.

# Ma'lumotlar papkasi (blog.db va yuklangan rasmlar shu yerda). Doimiy disk yo'lini bering
DATA_DIR=/var/lib/blog

# HTTPS bo'lmasa vaqtincha 0 qo'ying (aks holda login cookie ishlamaydi)
COOKIE_SECURE=1

# Gunicorn (ixtiyoriy)
# WEB_CONCURRENCY=2
# THREADS=4
# BIND=127.0.0.1:8000
