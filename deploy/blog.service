[Unit]
Description=Anonim blog (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/blog
EnvironmentFile=/opt/blog/.env
Environment=BIND=127.0.0.1:8000
ExecStart=/opt/blog/venv/bin/gunicorn wsgi:app -c gunicorn.conf.py
Restart=always
RestartSec=3

# Xavfsizlik
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/blog

[Install]
WantedBy=multi-user.target
